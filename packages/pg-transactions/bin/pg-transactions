#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd
)"

default_config_file() {
  local candidate

  for candidate in \
    "$SCRIPT_DIR/../share/db-tunnels.json" \
    "$SCRIPT_DIR/../share/db-tunnel/db-tunnels.json" \
    "$SCRIPT_DIR/db-tunnels.json"
  do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  printf '%s\n' "$SCRIPT_DIR/../share/db-tunnel/db-tunnels.json"
}

DEFAULT_CONFIG_FILE="$(default_config_file)"
CONFIG_FILE="${DB_TUNNELS_CONFIG:-$DEFAULT_CONFIG_FILE}"
TUNNEL_NAME="dev-writer"
HOST="${PGHOST:-}"
HOSTADDR="${PGHOSTADDR:-127.0.0.1}"
PORT="${PGPORT:-}"
DATABASE="${PGDATABASE:-}"
USER="${PGUSER:-${DB_TUNNEL_DB_USER:-}}"
SSLMODE="${PGSSLMODE:-require}"
INCLUDE_IDLE="false"
INCLUDE_IDLE_TXN="false"
ALL_CONNECTIONS="false"
GENERATE_TOKEN="false"
NO_PAGER="false"
OUTPUT_FORMAT="jsonl"

usage() {
  cat <<EOF
Usage:
  pg-transactions [options]

Shows PostgreSQL client connections through a local db-tunnel endpoint as
newline-delimited JSON. By default this connects to the dev writer tunnel's
local port and shows active sessions. Every tunnel in db-tunnels.json now
goes through an IAM-auth RDS Proxy shared by many identities, so you always
provide your own database role, most simply via PGUSER (the standard psql
variable).

Options:
  --idle               Include normal idle sessions.
  --idletxn            Include idle-in-transaction sessions.
  --include-idle       Alias for --idletxn.
  --all-connections    Include idle connections too, for endpoint sanity checks.
  --generate-token     Generate an IAM auth token and use it as PGPASSWORD.
  --tunnel NAME        Tunnel config entry to read the local port from. Default: dev-writer
  --host HOST          PostgreSQL hostname. Default: PGHOST or tunnel host
  --hostaddr ADDRESS   TCP address for the tunnel. Default: PGHOSTADDR or 127.0.0.1
  --port PORT          PostgreSQL port. Default: PGPORT or tunnel localPort
  --database NAME      PostgreSQL database. Default: PGDATABASE or tunnel database
  --user USER          Your database role. Default: PGUSER or DB_TUNNEL_DB_USER
  --sslmode MODE       PostgreSQL sslmode. Default: PGSSLMODE or require
  --table              Use the old psql table output instead of JSONL.
  --no-pager           Disable psql's pager.
  -h, --help           Show this help.

Environment:
  DB_TUNNELS_CONFIG    Override db-tunnels.json path.
  PGHOST, PGHOSTADDR,
  PGPORT, PGDATABASE,
  PGUSER, PGSSLMODE,
  PGPASSWORD           Standard psql connection settings — set PGUSER once
                       (e.g. in your shell profile) to your own database
                       role instead of passing --user every time.
  DB_TUNNEL_DB_USER    Fallback if PGUSER isn't set. Also read by db-tunnel,
                       db-auth-token, and tpsql.

Examples:
  db-tunnel open dev-writer
  pg-transactions --generate-token --user shauns
  pg-transactions --generate-token --all-connections | jq -r 'select(.user == "control_centre")'
  PGUSER=quintinw PGPASSWORD=... pg-transactions --idle --idletxn
EOF
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command: $command_name" >&2
    exit 1
  fi
}

check_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Config file not found: $CONFIG_FILE" >&2
    exit 1
  fi
}

read_tunnel_config() {
  check_config

  local exists
  exists="$(jq -r --arg name "$TUNNEL_NAME" '.tunnels[$name] != null' "$CONFIG_FILE")"

  if [[ "$exists" != "true" ]]; then
    echo "Unknown tunnel: $TUNNEL_NAME" >&2
    echo "Run db-tunnel list to see configured tunnels." >&2
    exit 1
  fi

  local tunnel_host tunnel_port tunnel_database tunnel_user

  tunnel_host="$(jq -r --arg name "$TUNNEL_NAME" '.tunnels[$name].host' "$CONFIG_FILE")"
  tunnel_port="$(jq -r --arg name "$TUNNEL_NAME" '.tunnels[$name].localPort' "$CONFIG_FILE")"
  tunnel_database="$(jq -r --arg name "$TUNNEL_NAME" '.tunnels[$name].database // ""' "$CONFIG_FILE")"
  tunnel_user="$(jq -r --arg name "$TUNNEL_NAME" '.tunnels[$name].user // .tunnels[$name].username // .tunnels[$name].dbUser // ""' "$CONFIG_FILE")"

  if [[ -z "$HOST" ]]; then
    HOST="$tunnel_host"
  fi

  if [[ -z "$PORT" ]]; then
    PORT="$tunnel_port"
  fi

  if [[ -z "$DATABASE" ]]; then
    DATABASE="$tunnel_database"
  fi

  if [[ -z "$USER" ]]; then
    USER="$tunnel_user"
  fi
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --idle)
        INCLUDE_IDLE="true"
        shift
        ;;

      --idletxn|--include-idle)
        INCLUDE_IDLE_TXN="true"
        shift
        ;;

      --all-connections)
        ALL_CONNECTIONS="true"
        shift
        ;;

      --generate-token)
        GENERATE_TOKEN="true"
        shift
        ;;

      --tunnel)
        if [[ $# -lt 2 ]]; then
          echo "Missing value for --tunnel." >&2
          exit 1
        fi
        TUNNEL_NAME="$2"
        shift 2
        ;;

      --host)
        if [[ $# -lt 2 ]]; then
          echo "Missing value for --host." >&2
          exit 1
        fi
        HOST="$2"
        shift 2
        ;;

      --hostaddr)
        if [[ $# -lt 2 ]]; then
          echo "Missing value for --hostaddr." >&2
          exit 1
        fi
        HOSTADDR="$2"
        shift 2
        ;;

      --port)
        if [[ $# -lt 2 ]]; then
          echo "Missing value for --port." >&2
          exit 1
        fi
        PORT="$2"
        shift 2
        ;;

      --database)
        if [[ $# -lt 2 ]]; then
          echo "Missing value for --database." >&2
          exit 1
        fi
        DATABASE="$2"
        shift 2
        ;;

      --user)
        if [[ $# -lt 2 ]]; then
          echo "Missing value for --user." >&2
          exit 1
        fi
        USER="$2"
        shift 2
        ;;

      --sslmode)
        if [[ $# -lt 2 ]]; then
          echo "Missing value for --sslmode." >&2
          exit 1
        fi
        SSLMODE="$2"
        shift 2
        ;;

      --table)
        OUTPUT_FORMAT="table"
        shift
        ;;

      --no-pager)
        NO_PAGER="true"
        shift
        ;;

      -h|--help)
        usage
        exit 0
        ;;

      *)
        echo "Unknown argument: $1" >&2
        usage
        exit 1
        ;;
    esac
  done
}

run_query() {
  read_tunnel_config

  if [[ -z "$PORT" || "$PORT" == "null" ]]; then
    echo "Tunnel '$TUNNEL_NAME' is missing localPort, and PGPORT/--port was not set." >&2
    exit 1
  fi

  if [[ -z "$HOST" || "$HOST" == "null" ]]; then
    echo "Tunnel '$TUNNEL_NAME' is missing host, and PGHOST/--host was not set." >&2
    exit 1
  fi

  if [[ -z "$HOSTADDR" || "$HOSTADDR" == "null" ]]; then
    echo "PGHOSTADDR/--hostaddr cannot be empty when connecting through a tunnel." >&2
    exit 1
  fi

  if [[ -z "$DATABASE" || "$DATABASE" == "null" ]]; then
    echo "Tunnel '$TUNNEL_NAME' is missing database, and PGDATABASE/--database was not set." >&2
    exit 1
  fi

  if [[ -z "$USER" || "$USER" == "null" ]]; then
    echo "Tunnel '$TUNNEL_NAME' is missing user, and PGUSER/--user was not set." >&2
    exit 1
  fi

  local password="${PGPASSWORD:-}"
  if [[ "$GENERATE_TOKEN" == "true" ]]; then
    local db_auth_token_command="${DB_AUTH_TOKEN_COMMAND:-}"

    if [[ -z "$db_auth_token_command" ]]; then
      if [[ -x "$SCRIPT_DIR/db-auth-token" ]]; then
        db_auth_token_command="$SCRIPT_DIR/db-auth-token"
      else
        db_auth_token_command="db-auth-token"
      fi
    fi

    password="$("$db_auth_token_command" "$TUNNEL_NAME" --db-user "$USER")"
  fi

  local conninfo="host=$HOST hostaddr=$HOSTADDR port=$PORT dbname=$DATABASE user=$USER sslmode=$SSLMODE"
  local -a psql_args=(
    --no-psqlrc
    "$conninfo"
    --set "include_idle=$INCLUDE_IDLE"
    --set "include_idle_txn=$INCLUDE_IDLE_TXN"
    --set "all_connections=$ALL_CONNECTIONS"
    --set ON_ERROR_STOP=1
    --quiet
  )

  if [[ "$NO_PAGER" == "true" ]]; then
    psql_args+=(--pset pager=off)
  fi

  run_psql() {
    if [[ "$OUTPUT_FORMAT" == "jsonl" ]]; then
      psql "${psql_args[@]}" <<'SQL'
\pset tuples_only on
\pset format unaligned
\pset pager off

SELECT jsonb_build_object(
  'pid', pid,
  'user', usename,
  'database', datname,
  'backend_type', backend_type,
  'app', application_name,
  'client_addr', host(client_addr),
  'state', state,
  'wait_type', wait_event_type,
  'wait_event', wait_event,
  'blocking_pids', pg_blocking_pids(pid),
  'xact_age', age(clock_timestamp(), xact_start),
  'query_age', age(clock_timestamp(), query_start),
  'query', query
)::text
FROM pg_stat_activity
WHERE pid <> pg_backend_pid()
  AND (
    :'all_connections'::boolean
    OR (
      backend_type = 'client backend'
      AND (
        state = 'active'
        OR (:'include_idle'::boolean AND state = 'idle')
        OR (:'include_idle_txn'::boolean AND state LIKE 'idle in transaction%')
      )
    )
  )
ORDER BY
  backend_type = 'client backend' DESC,
  state = 'active' DESC,
  xact_start NULLS LAST,
  query_start NULLS LAST,
  pid;
SQL
      return
    fi

    psql "${psql_args[@]}" <<'SQL'
\pset border 2
\pset null -
\x off

SELECT
  pid,
  usename AS "user",
  datname AS database,
  backend_type,
  application_name AS app,
  client_addr,
  state,
  wait_event_type AS wait_type,
  wait_event,
  pg_blocking_pids(pid) AS blocking_pids,
  age(clock_timestamp(), xact_start) AS xact_age,
  age(clock_timestamp(), query_start) AS query_age,
  regexp_replace(left(query, 180), '[[:space:]]+', ' ', 'g') AS query
FROM pg_stat_activity
WHERE pid <> pg_backend_pid()
  AND (
    :'all_connections'::boolean
    OR (
      backend_type = 'client backend'
      AND (
        state = 'active'
        OR (:'include_idle'::boolean AND state = 'idle')
        OR (:'include_idle_txn'::boolean AND state LIKE 'idle in transaction%')
      )
    )
  )
ORDER BY
  backend_type = 'client backend' DESC,
  state = 'active' DESC,
  xact_start NULLS LAST,
  query_start NULLS LAST,
  pid;
SQL
  }

  if [[ -n "$password" ]]; then
    PGPASSWORD="$password" run_psql
  else
    run_psql
  fi
}

main() {
  require_command jq
  require_command psql
  parse_args "$@"
  run_query
}

main "$@"
