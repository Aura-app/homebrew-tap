#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd
)"

default_config_file() {
  local candidate

  for candidate in \
    "$SCRIPT_DIR/../share/db-tunnels.json" \
    "$SCRIPT_DIR/../share/db-tunnel/db-tunnels.json" \
    "$SCRIPT_DIR/db-tunnels.json"
  do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  printf '%s\n' "$SCRIPT_DIR/../share/db-tunnels.json"
}

DEFAULT_CONFIG_FILE="$(default_config_file)"
CONFIG_FILE="${DB_TUNNELS_CONFIG:-$DEFAULT_CONFIG_FILE}"
TUNNEL_PID=""
DBEAVER_TEMP_DIR=""
DBEAVER_LAUNCH_MODE=""
DBEAVER_LAUNCH_TARGET=""
DB_AUTH_TOKEN_EXECUTABLE=""
RESOLVED_DB_USER=""

usage() {
  cat <<EOF
Usage:
  db-tunnel list
  db-tunnel open <name> [--local-port PORT] [--dbeaver] [--db-user USER]
  db-tunnel valentina <name>
  db-tunnel doctor

Commands:
  list        Show the available database tunnels.
  open        Open a tunnel and keep it open until Ctrl-C.
  valentina   One-time setup of a Valentina Studio connection for a tunnel.
  doctor      Check this computer's setup; paste the output into a support
              ticket if something does not work.

Examples:
  db-tunnel list
  db-tunnel open dev
  db-tunnel open dev-writer --local-port 15440
  db-tunnel open staging --dbeaver
  db-tunnel valentina production

Your database user is your AWS IAM user name in lowercase. Set PGUSER (or
pass --db-user) only if yours is named differently.

Environment:
  DB_TUNNELS_CONFIG  Override config file path.
  PGUSER             Your database role, if it is not your IAM user name in
                     lowercase.
  DB_TUNNEL_DBEAVER_EXECUTABLE
                     Override the DBeaver executable used by --dbeaver.
EOF
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command: $command_name" >&2
    exit 1
  fi
}

ensure_session_manager_plugin() {
  if command -v session-manager-plugin >/dev/null 2>&1; then
    return
  fi

  echo "Missing required command: session-manager-plugin" >&2
  echo >&2

  if ! command -v brew >/dev/null 2>&1; then
    echo "Install it with Homebrew before opening a tunnel:" >&2
    echo >&2
    echo "  brew install --cask session-manager-plugin" >&2
    exit 1
  fi

  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "Install it before opening a tunnel:" >&2
    echo >&2
    echo "  brew install --cask session-manager-plugin" >&2
    exit 1
  fi

  local response
  read -r -p "Install session-manager-plugin with Homebrew now? [y/N] " response

  case "$response" in
    y|Y|yes|YES)
      brew install --cask session-manager-plugin
      ;;
    *)
      echo "Install it before opening a tunnel:" >&2
      echo >&2
      echo "  brew install --cask session-manager-plugin" >&2
      exit 1
      ;;
  esac

  if ! command -v session-manager-plugin >/dev/null 2>&1; then
    echo "session-manager-plugin still was not found on PATH after installation." >&2
    exit 1
  fi
}

check_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Config file not found: $CONFIG_FILE" >&2
    exit 1
  fi
}

list_tunnels() {
  check_config

  echo "Available database tunnels:"
  echo

  jq -r '
    .tunnels
    | to_entries[]
    | "  \(.key)\n    description: \(.value.description // "-")\n    local:       localhost:\(.value.localPort)\n    remote:      \(.value.host):\(.value.remotePort)\n    database:    \(.value.database // "-")\n    profile:     \(.value.profile)\n"
  ' "$CONFIG_FILE"
}

uses_sso() {
  [[ -n "$(aws configure get sso_start_url --profile "$1" 2>/dev/null)$(aws configure get sso_session --profile "$1" 2>/dev/null)" ]]
}

ensure_aws_login() {
  local profile="$1"

  if aws sts get-caller-identity --profile "$profile" >/dev/null 2>&1; then
    return
  fi

  if uses_sso "$profile"; then
    echo "AWS profile '$profile' is not currently authenticated." >&2
    echo "Attempting AWS SSO login..." >&2
    aws sso login --profile "$profile" >&2
    return
  fi

  echo "AWS sign-in is not set up on this computer, or your access key is no longer valid." >&2
  echo "Run 'aws configure' and enter the access key you were given (region: eu-west-1)." >&2
  exit 1
}

tunnel_field() {
  jq -r --arg name "$1" --arg field "$2" '.tunnels[$name][$field] // empty' "$CONFIG_FILE"
}

require_tunnel() {
  check_config
  if [[ "$(jq -r --arg name "$1" '.tunnels[$name] != null' "$CONFIG_FILE")" != "true" ]]; then
    echo "Unknown tunnel: $1" >&2
    echo >&2
    list_tunnels >&2
    exit 1
  fi
}

# Explicit --db-user/env vars first, then db-auth-token's default from the AWS identity.
db_user_for_tunnel() {
  local tunnel_name="$1" override="${2:-}"

  resolve_db_user "$override"
  if [[ -n "$RESOLVED_DB_USER" ]]; then
    printf '%s\n' "$RESOLVED_DB_USER"
    return
  fi
  resolve_db_auth_token_executable
  "$DB_AUTH_TOKEN_EXECUTABLE" "$tunnel_name" --print-user
}

share_file() {
  local candidate

  for candidate in \
    "$SCRIPT_DIR/../share/$1" \
    "$SCRIPT_DIR/../share/db-tunnel/$1"
  do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  return 1
}

resolve_db_auth_token_executable() {
  local configured_command="${DB_AUTH_TOKEN_COMMAND:-}"

  if [[ -n "$configured_command" ]]; then
    if [[ "$configured_command" == */* ]]; then
      if [[ ! -x "$configured_command" ]]; then
        echo "DB_AUTH_TOKEN_COMMAND is not executable: $configured_command" >&2
        return 1
      fi
      DB_AUTH_TOKEN_EXECUTABLE="$configured_command"
      return
    fi

    if ! DB_AUTH_TOKEN_EXECUTABLE="$(command -v "$configured_command" 2>/dev/null)"; then
      echo "DB_AUTH_TOKEN_COMMAND was not found on PATH: $configured_command" >&2
      return 1
    fi
    return
  fi

  if [[ -x "$SCRIPT_DIR/db-auth-token" ]]; then
    DB_AUTH_TOKEN_EXECUTABLE="$SCRIPT_DIR/db-auth-token"
    return
  fi

  if ! DB_AUTH_TOKEN_EXECUTABLE="$(command -v db-auth-token 2>/dev/null)"; then
    echo "Missing required command: db-auth-token" >&2
    return 1
  fi
}

resolve_db_user() {
  local override="$1"

  RESOLVED_DB_USER=""

  if [[ -n "$override" ]]; then
    RESOLVED_DB_USER="$override"
  elif [[ -n "${DB_AUTH_TOKEN_DB_USER:-}" ]]; then
    RESOLVED_DB_USER="$DB_AUTH_TOKEN_DB_USER"
  elif [[ -n "${PGUSER:-}" ]]; then
    RESOLVED_DB_USER="$PGUSER"
  elif [[ -n "${DB_TUNNEL_DB_USER:-}" ]]; then
    RESOLVED_DB_USER="$DB_TUNNEL_DB_USER"
  fi
}

resolve_dbeaver_launcher() {
  local configured_executable="${DB_TUNNEL_DBEAVER_EXECUTABLE:-}"
  local platform
  local candidate

  if [[ -n "$configured_executable" ]]; then
    if [[ "$configured_executable" == */* ]]; then
      if [[ ! -x "$configured_executable" ]]; then
        echo "DB_TUNNEL_DBEAVER_EXECUTABLE is not executable: $configured_executable" >&2
        return 1
      fi
      DBEAVER_LAUNCH_TARGET="$configured_executable"
    elif ! DBEAVER_LAUNCH_TARGET="$(command -v "$configured_executable" 2>/dev/null)"; then
      echo "DB_TUNNEL_DBEAVER_EXECUTABLE was not found on PATH: $configured_executable" >&2
      return 1
    fi

    DBEAVER_LAUNCH_MODE="executable"
    return
  fi

  platform="$(uname -s)"

  case "$platform" in
    Darwin)
      require_command open

      for candidate in \
        DBeaver.app \
        DBeaverLite.app \
        DBeaverEE.app \
        DBeaverUltimate.app
      do
        if open -Ra "$candidate" >/dev/null 2>&1; then
          DBEAVER_LAUNCH_MODE="macos_app"
          DBEAVER_LAUNCH_TARGET="$candidate"
          return
        fi
      done

      echo "DBeaver was not found." >&2
      echo "Checked for: DBeaver.app, DBeaverLite.app, DBeaverEE.app, DBeaverUltimate.app." >&2
      ;;

    Linux)
      for candidate in \
        dbeaver \
        dbeaver-ce \
        dbeaver-ee \
        dbeaver-le \
        dbeaver-lite \
        dbeaver-ue \
        dbeaver-ultimate
      do
        if DBEAVER_LAUNCH_TARGET="$(command -v "$candidate" 2>/dev/null)"; then
          DBEAVER_LAUNCH_MODE="executable"
          return
        fi
      done

      echo "DBeaver was not found." >&2
      echo "Checked PATH for: dbeaver, dbeaver-ce, dbeaver-ee, dbeaver-le," >&2
      echo "dbeaver-lite, dbeaver-ue, and dbeaver-ultimate." >&2
      ;;

    *)
      echo "DBeaver launching is supported only on Linux and macOS, not: $platform" >&2
      return 1
      ;;
  esac

  echo "Install a supported DBeaver edition, or set" >&2
  echo "DB_TUNNEL_DBEAVER_EXECUTABLE to its executable path." >&2
  return 1
}

port_is_open() {
  local port="$1"

  (exec 3<>"/dev/tcp/127.0.0.1/$port") >/dev/null 2>&1
}

wait_for_tunnel() {
  local local_port="$1"
  local attempts=0
  local status

  while (( attempts < 60 )); do
    if ! kill -0 "$TUNNEL_PID" >/dev/null 2>&1; then
      if wait "$TUNNEL_PID"; then
        status=0
      else
        status=$?
      fi
      echo "Database tunnel exited before local port $local_port became ready (status $status)." >&2
      return 1
    fi

    if port_is_open "$local_port"; then
      return
    fi

    sleep 0.5
    attempts=$((attempts + 1))
  done

  echo "Timed out waiting 30 seconds for the database tunnel on 127.0.0.1:$local_port." >&2
  return 1
}

cleanup_dbeaver_session() {
  local status=$?

  trap - EXIT INT TERM

  if [[ -n "$TUNNEL_PID" ]]; then
    if kill -0 -- "-$TUNNEL_PID" >/dev/null 2>&1; then
      kill -TERM -- "-$TUNNEL_PID" >/dev/null 2>&1 || true
    elif kill -0 "$TUNNEL_PID" >/dev/null 2>&1; then
      kill -TERM "$TUNNEL_PID" >/dev/null 2>&1 || true
    fi
    wait "$TUNNEL_PID" >/dev/null 2>&1 || true
  fi
  TUNNEL_PID=""

  if [[ -n "$DBEAVER_TEMP_DIR" ]]; then
    rm -f -- \
      "$DBEAVER_TEMP_DIR/variables.properties" \
      "$DBEAVER_TEMP_DIR/dbeaver.log"
    rmdir -- "$DBEAVER_TEMP_DIR" 2>/dev/null || true
  fi
  DBEAVER_TEMP_DIR=""

  return "$status"
}

launch_dbeaver() {
  local tunnel_name="$1"
  local local_port="$2"
  local database="$3"
  local db_user="$4"
  local token="$5"
  local variables_file
  local log_file
  local connection_spec
  local launch_pid
  local launch_status

  for value in "$tunnel_name" "$database" "$db_user"; do
    if [[ "$value" == *"|"* || "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
      echo "DBeaver connection values cannot contain pipes or newlines." >&2
      return 1
    fi
  done

  DBEAVER_TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/db-tunnel-dbeaver.XXXXXX")"
  variables_file="$DBEAVER_TEMP_DIR/variables.properties"
  log_file="$DBEAVER_TEMP_DIR/dbeaver.log"

  (umask 077 && printf 'password=%s\n' "$token" > "$variables_file")

  connection_spec="driver=postgres-jdbc|name=Aura $tunnel_name|host=127.0.0.1|port=$local_port|database=$database|user=$db_user|password=\${password}|prop.sslmode=require|connect=true|create=true|save=false"

  case "$DBEAVER_LAUNCH_MODE" in
    macos_app)
      if ! open -a "$DBEAVER_LAUNCH_TARGET" --args \
        -bringToFront \
        -vars "$variables_file" \
        -con "$connection_spec"
      then
        echo "Failed to launch $DBEAVER_LAUNCH_TARGET." >&2
        return 1
      fi
      ;;

    executable)
      set -m
      "$DBEAVER_LAUNCH_TARGET" \
        -bringToFront \
        -vars "$variables_file" \
        -con "$connection_spec" \
        >"$log_file" 2>&1 &
      launch_pid=$!
      set +m

      sleep 1
      if ! kill -0 "$launch_pid" >/dev/null 2>&1; then
        if wait "$launch_pid"; then
          launch_status=0
        else
          launch_status=$?
        fi

        if [[ "$launch_status" -ne 0 ]]; then
          echo "DBeaver exited during launch (status $launch_status)." >&2
          if [[ -s "$log_file" ]]; then
            cat "$log_file" >&2
          fi
          return 1
        fi
      else
        disown "$launch_pid" 2>/dev/null || true
      fi
      ;;

    *)
      echo "Internal error: no DBeaver launcher was selected." >&2
      return 1
      ;;
  esac

  echo
  echo "DBeaver launched with a temporary 'Aura $tunnel_name' connection."
  echo "The IAM token is not saved in DBeaver and may be used only while it is valid."
}

start_tunnel_session() {
  local profile="$1"
  local region="$2"
  local target="$3"
  local host="$4"
  local remote_port="$5"
  local local_port="$6"

  exec aws ssm start-session \
    --profile "$profile" \
    --region "$region" \
    --target "$target" \
    --document-name AWS-StartPortForwardingSessionToRemoteHost \
    --parameters "host=$host,portNumber=$remote_port,localPortNumber=$local_port"
}

start_background_tunnel_session() {
  set -m
  start_tunnel_session "$@" &
  TUNNEL_PID=$!
  set +m
}

open_tunnel() {
  local tunnel_name=""
  local local_port_override=""
  local launch_dbeaver_requested="false"
  local db_user_override=""

  if [[ $# -lt 1 ]]; then
    echo "Missing tunnel name." >&2
    usage
    exit 1
  fi

  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    exit 0
  fi

  if [[ "$1" == -* ]]; then
    echo "First argument must be the tunnel name, got: $1" >&2
    usage
    exit 1
  fi

  tunnel_name="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --local-port)
        if [[ $# -lt 2 ]]; then
          echo "Missing value for --local-port." >&2
          exit 1
        fi
        if [[ ! "$2" =~ ^[0-9]+$ ]]; then
          echo "Invalid value for --local-port: $2" >&2
          exit 1
        fi
        local_port_override="$2"
        shift 2
        ;;

      --dbeaver)
        launch_dbeaver_requested="true"
        shift
        ;;

      --db-user)
        if [[ $# -lt 2 ]]; then
          echo "Missing value for --db-user." >&2
          exit 1
        fi
        if [[ -z "$2" || "$2" == -* ]]; then
          echo "Invalid value for --db-user: $2" >&2
          exit 1
        fi
        db_user_override="$2"
        shift 2
        ;;

      -h|--help)
        usage
        exit 0
        ;;

      *)
        echo "Unknown argument: $1" >&2
        usage
        exit 1
        ;;
    esac
  done

  if [[ -n "$db_user_override" && "$launch_dbeaver_requested" != "true" ]]; then
    echo "--db-user is supported only with --dbeaver." >&2
    exit 1
  fi

  check_config

  local exists
  exists="$(jq -r --arg name "$tunnel_name" '.tunnels[$name] != null' "$CONFIG_FILE")"

  if [[ "$exists" != "true" ]]; then
    echo "Unknown tunnel: $tunnel_name" >&2
    echo >&2
    list_tunnels >&2
    exit 1
  fi

  local profile region target host database remote_port local_port description

  profile="$(jq -r --arg name "$tunnel_name" '.tunnels[$name].profile' "$CONFIG_FILE")"
  region="$(jq -r --arg name "$tunnel_name" '.tunnels[$name].region' "$CONFIG_FILE")"
  target="$(jq -r --arg name "$tunnel_name" '.tunnels[$name].target' "$CONFIG_FILE")"
  host="$(jq -r --arg name "$tunnel_name" '.tunnels[$name].host' "$CONFIG_FILE")"
  database="$(jq -r --arg name "$tunnel_name" '.tunnels[$name].database' "$CONFIG_FILE")"
  remote_port="$(jq -r --arg name "$tunnel_name" '.tunnels[$name].remotePort' "$CONFIG_FILE")"
  local_port="$(jq -r --arg name "$tunnel_name" '.tunnels[$name].localPort' "$CONFIG_FILE")"
  description="$(jq -r --arg name "$tunnel_name" '.tunnels[$name].description // ""' "$CONFIG_FILE")"

  if [[ -n "$local_port_override" ]]; then
    local_port="$local_port_override"
  fi

  if [[ -z "$profile" || "$profile" == "null" ]]; then
    echo "Tunnel '$tunnel_name' is missing profile." >&2
    exit 1
  fi

  if [[ -z "$region" || "$region" == "null" ]]; then
    echo "Tunnel '$tunnel_name' is missing region." >&2
    exit 1
  fi

  if [[ -z "$target" || "$target" == "null" ]]; then
    echo "Tunnel '$tunnel_name' is missing target." >&2
    exit 1
  fi

  if [[ -z "$host" || "$host" == "null" ]]; then
    echo "Tunnel '$tunnel_name' is missing host." >&2
    exit 1
  fi

  if [[ -z "$database" || "$database" == "null" ]]; then
    echo "Tunnel '$tunnel_name' is missing database." >&2
    exit 1
  fi

  if [[ -z "$remote_port" || "$remote_port" == "null" ]]; then
    echo "Tunnel '$tunnel_name' is missing remotePort." >&2
    exit 1
  fi

  if [[ -z "$local_port" || "$local_port" == "null" ]]; then
    echo "Tunnel '$tunnel_name' is missing localPort." >&2
    exit 1
  fi

  local db_user=""

  if [[ "$launch_dbeaver_requested" == "true" ]]; then
    resolve_db_auth_token_executable
    db_user="$(db_user_for_tunnel "$tunnel_name" "$db_user_override")"
    resolve_dbeaver_launcher

    if port_is_open "$local_port"; then
      echo "Local port $local_port is already in use; refusing to launch DBeaver against an unknown listener." >&2
      exit 1
    fi
  fi

  ensure_session_manager_plugin
  ensure_aws_login "$profile"

  echo "Starting database tunnel:"
  echo
  echo "  tunnel:      $tunnel_name"
  if [[ -n "$description" && "$description" != "null" ]]; then
    echo "  description: $description"
  fi
  echo "  profile:     $profile"
  echo "  region:      $region"
  echo "  target:      $target"
  echo "  remote:      $host:$remote_port"
  echo "  local:       localhost:$local_port"
  echo "  database:    $database"
  echo
  if [[ "$launch_dbeaver_requested" == "true" ]]; then
    echo "  client:      DBeaver"
  else
    db_user="$(db_user_for_tunnel "$tunnel_name" 2>/dev/null || echo "<your-database-user>")"
    echo "Connect with your database tool (e.g. Valentina Studio) to:"
    echo
    echo "  host 127.0.0.1, port $local_port, database $database, user $db_user, SSL required"
    echo
    echo "or from another terminal:"
    echo
    echo "  PGPASSWORD=\"\$(db-auth-token $tunnel_name)\" psql -h localhost -p $local_port -U $db_user $database"
  fi

  if [[ "$launch_dbeaver_requested" != "true" ]]; then
    echo
    echo "Press Ctrl-C to close the tunnel."
    echo
  fi

  if [[ "$launch_dbeaver_requested" != "true" ]]; then
    start_tunnel_session "$profile" "$region" "$target" "$host" "$remote_port" "$local_port"
    return
  fi

  trap cleanup_dbeaver_session EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  start_background_tunnel_session \
    "$profile" "$region" "$target" "$host" "$remote_port" "$local_port"

  wait_for_tunnel "$local_port"

  local token
  token="$("$DB_AUTH_TOKEN_EXECUTABLE" "$tunnel_name" --db-user "$db_user")"
  launch_dbeaver "$tunnel_name" "$local_port" "$database" "$db_user" "$token"

  echo
  echo "Press Ctrl-C to close the tunnel. DBeaver will remain open."
  echo

  local tunnel_status
  if wait "$TUNNEL_PID"; then
    tunnel_status=0
  else
    tunnel_status=$?
  fi
  if [[ "$tunnel_status" -ne 0 ]]; then
    echo "Database tunnel exited (status $tunnel_status)." >&2
    return "$tunnel_status"
  fi
}

setup_valentina() {
  if [[ $# -ne 1 || "$1" == -* ]]; then
    echo "Usage: db-tunnel valentina <name>" >&2
    exit 1
  fi

  local tunnel_name="$1" hook db_user script

  require_tunnel "$tunnel_name"
  hook="$(share_file valentina-pre-connect.py)" || {
    echo "valentina-pre-connect.py is missing from this installation; reinstall db-tunnel." >&2
    exit 1
  }
  ensure_aws_login "$(tunnel_field "$tunnel_name" profile)"
  db_user="$(db_user_for_tunnel "$tunnel_name")"
  script="$(sed "s/^TUNNEL_NAME = .*/TUNNEL_NAME = \"$tunnel_name\"/" "$hook")"

  cat <<EOF
Valentina Studio setup for "$tunnel_name" (once per computer)

1. In Valentina Studio, create a new PostgreSQL connection (bookmark) with:

     Host:      127.0.0.1
     Port:      $(tunnel_field "$tunnel_name" localPort)
     Database:  $(tunnel_field "$tunnel_name" database)
     User:      $db_user
     Password:  leave empty
     SSL:       on

EOF

  if command -v pbcopy >/dev/null 2>&1; then
    printf '%s\n' "$script" | pbcopy
    cat <<EOF
2. Open the connection's "Pre Connect" script editor and paste (Cmd-V).
   The script is already on your clipboard.
EOF
  else
    cat <<EOF
2. Open the connection's "Pre Connect" script editor and paste in this script:

$script

EOF
  fi

  cat <<EOF

3. Save the connection.

Each time you want to use it:

  - In Terminal, run:  db-tunnel open $tunnel_name
    and leave that window open.
  - In Valentina Studio, open the connection.
  - When you are finished, press Ctrl-C in the Terminal window.
EOF
}

doctor() {
  local problems=0 profile identity db_user

  check() {
    if [[ "$1" == "ok" ]]; then
      printf '  ✔ %s\n' "$2"
    else
      printf '  ✘ %s\n' "$2"
      [[ -n "${3:-}" ]] && printf '      → %s\n' "$3"
      problems=$((problems + 1))
    fi
  }

  echo "db-tunnel doctor"
  echo
  echo "  computer:   $(uname -sm)"
  echo "  db-tunnel:  $SCRIPT_DIR/db-tunnel"
  echo "  config:     $CONFIG_FILE"
  echo

  local plugin_hint="brew install --cask session-manager-plugin" config_hint="brew reinstall db-tunnel"
  if [[ "$(uname -s)" == "Darwin" ]]; then
    if command -v brew >/dev/null 2>&1; then check ok "Homebrew installed"; else check fail "Homebrew not found" "install it from https://brew.sh"; fi
  else
    plugin_hint="see the Windows (WSL) appendix in the homebrew-tap README"
    config_hint="git pull in your homebrew-tap clone"
  fi
  check ok "AWS CLI installed ($(aws --version 2>&1 | cut -d' ' -f1))"
  if command -v session-manager-plugin >/dev/null 2>&1; then
    check ok "Session Manager plugin installed"
  else
    check fail "Session Manager plugin not found" "$plugin_hint"
  fi
  if [[ -f "$CONFIG_FILE" ]]; then check ok "tunnel list found"; else check fail "tunnel list missing: $CONFIG_FILE" "$config_hint"; fi

  profile="$(jq -r '[.tunnels[].profile] | unique | .[0]' "$CONFIG_FILE" 2>/dev/null || echo default)"
  if identity="$(aws sts get-caller-identity --profile "$profile" --query Arn --output text 2>/dev/null)"; then
    check ok "signed in to AWS as ${identity##*/} (profile $profile)"
    if db_user="$(db_user_for_tunnel "$(jq -r '.tunnels | keys[0]' "$CONFIG_FILE")" 2>/dev/null)"; then
      check ok "database user: $db_user"
    else
      check fail "could not work out your database user" "set PGUSER to your database user"
    fi
  else
    check fail "not signed in to AWS (profile $profile)" "run: aws configure"
  fi

  echo
  if (( problems == 0 )); then
    echo "Everything on this computer looks fine. If you still cannot connect, log a"
    echo "support ticket and include this output and the error you see."
  else
    echo "$problems problem(s) found. Fix them as suggested above, or log a support"
    echo "ticket and include this output."
    return 1
  fi
}

main() {
  require_command jq
  require_command aws

  if [[ $# -lt 1 ]]; then
    usage
    exit 1
  fi

  local command="$1"
  shift

  case "$command" in
    list)
      list_tunnels "$@"
      ;;

    open)
      open_tunnel "$@"
      ;;

    valentina)
      setup_valentina "$@"
      ;;

    doctor)
      doctor
      ;;

    -h|--help|help)
      usage
      ;;

    *)
      echo "Unknown command: $command" >&2
      usage
      exit 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
