#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd
)"

default_config_file() {
  local candidate

  for candidate in \
    "$SCRIPT_DIR/../share/db-tunnels.json" \
    "$SCRIPT_DIR/../share/db-tunnel/db-tunnels.json" \
    "$SCRIPT_DIR/db-tunnels.json"
  do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  printf '%s\n' "$SCRIPT_DIR/../share/db-tunnels.json"
}

DEFAULT_CONFIG_FILE="$(default_config_file)"
CONFIG_FILE="${DB_TUNNELS_CONFIG:-$DEFAULT_CONFIG_FILE}"

usage() {
  cat <<EOF
Usage:
  db-auth-token <name> [--db-user USER]
  db-auth-token <name> --print-user

Examples:
  PGPASSWORD="\$(db-auth-token dev-writer)" psql -h localhost -p 15432 devtest
  db-auth-token production --print-user

Database role:
  Every tunnel goes through an IAM-auth RDS Proxy shared by many identities,
  so the token is for your own database role. By default that is your AWS IAM
  user name in lowercase (IAM user "Jane" connects as "jane"). Set PGUSER, or
  pass --db-user, only if your role is named differently.

  --print-user prints the role that would be used, without making a token.

Config:
  Reads profile, region, host, and remotePort from db-tunnels.json.

Environment:
  DB_TUNNELS_CONFIG      Override config file path.
  PGUSER                 Your database role, if it is not your IAM user name
                         in lowercase. The standard psql variable, so psql
                         picks it up too.
  DB_AUTH_TOKEN_DB_USER  Override specific to this command, if you ever need
                         a different user here than PGUSER.
  DB_TUNNEL_DB_USER      Lower-priority fallback if neither PGUSER nor
                         DB_AUTH_TOKEN_DB_USER is set. Also read by
                         db-tunnel, tpsql, and pg-transactions.
EOF
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command: $command_name" >&2
    exit 1
  fi
}

check_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Config file not found: $CONFIG_FILE" >&2
    exit 1
  fi
}

CALLER_ARN=""

ensure_aws_login() {
  local profile="$1"

  if CALLER_ARN="$(aws sts get-caller-identity --profile "$profile" --query Arn --output text 2>/dev/null)"; then
    return
  fi

  if [[ -n "$(aws configure get sso_start_url --profile "$profile" 2>/dev/null)$(aws configure get sso_session --profile "$profile" 2>/dev/null)" ]]; then
    echo "AWS profile '$profile' is not currently authenticated." >&2
    echo "Attempting AWS SSO login..." >&2
    aws sso login --profile "$profile" >&2
    CALLER_ARN="$(aws sts get-caller-identity --profile "$profile" --query Arn --output text)"
    return
  fi

  echo "AWS sign-in is not set up on this computer, or your access key is no longer valid." >&2
  echo "Run 'aws configure' and enter the access key you were given (region: eu-west-1)." >&2
  exit 1
}

# IAM user "Jane" maps to database role "jane"; other identities must set PGUSER.
user_from_caller_arn() {
  case "$CALLER_ARN" in
    arn:aws:iam::*:user/*)
      printf '%s\n' "${CALLER_ARN##*/}" | tr '[:upper:]' '[:lower:]'
      ;;
  esac
}

generate_token() {
  local tunnel_name=""
  local db_user_override=""
  local print_user="false"

  if [[ $# -lt 1 ]]; then
    echo "Missing tunnel name." >&2
    usage
    exit 1
  fi

  if [[ "$1" == -* ]]; then
    echo "First argument must be the tunnel name, got: $1" >&2
    usage
    exit 1
  fi

  tunnel_name="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --db-user|--username|--user)
        if [[ $# -lt 2 ]]; then
          echo "Missing value for $1." >&2
          exit 1
        fi
        db_user_override="$2"
        shift 2
        ;;

      --print-user)
        print_user="true"
        shift
        ;;

      -h|--help)
        usage
        exit 0
        ;;

      *)
        echo "Unknown argument: $1" >&2
        usage
        exit 1
        ;;
    esac
  done

  check_config

  local exists
  exists="$(jq -r --arg name "$tunnel_name" '.tunnels[$name] != null' "$CONFIG_FILE")"

  if [[ "$exists" != "true" ]]; then
    echo "Unknown tunnel: $tunnel_name" >&2
    echo "Run db-tunnel list to see configured tunnels." >&2
    exit 1
  fi

  local profile region host remote_port db_user

  profile="$(jq -r --arg name "$tunnel_name" '.tunnels[$name].profile' "$CONFIG_FILE")"
  region="$(jq -r --arg name "$tunnel_name" '.tunnels[$name].region' "$CONFIG_FILE")"
  host="$(jq -r --arg name "$tunnel_name" '.tunnels[$name].host' "$CONFIG_FILE")"
  remote_port="$(jq -r --arg name "$tunnel_name" '.tunnels[$name].remotePort' "$CONFIG_FILE")"
  db_user="$(jq -r --arg name "$tunnel_name" '.tunnels[$name].user // .tunnels[$name].username // .tunnels[$name].dbUser // ""' "$CONFIG_FILE")"

  if [[ -n "$db_user_override" ]]; then
    db_user="$db_user_override"
  elif [[ -n "${DB_AUTH_TOKEN_DB_USER:-}" ]]; then
    db_user="$DB_AUTH_TOKEN_DB_USER"
  elif [[ -n "${PGUSER:-}" ]]; then
    db_user="$PGUSER"
  elif [[ -n "${DB_TUNNEL_DB_USER:-}" ]]; then
    db_user="$DB_TUNNEL_DB_USER"
  fi

  if [[ -z "$profile" || "$profile" == "null" ]]; then
    echo "Tunnel '$tunnel_name' is missing profile." >&2
    exit 1
  fi

  if [[ -z "$region" || "$region" == "null" ]]; then
    echo "Tunnel '$tunnel_name' is missing region." >&2
    exit 1
  fi

  if [[ -z "$host" || "$host" == "null" ]]; then
    echo "Tunnel '$tunnel_name' is missing host." >&2
    exit 1
  fi

  if [[ -z "$remote_port" || "$remote_port" == "null" ]]; then
    echo "Tunnel '$tunnel_name' is missing remotePort." >&2
    exit 1
  fi

  ensure_aws_login "$profile"

  if [[ -z "$db_user" || "$db_user" == "null" ]]; then
    db_user="$(user_from_caller_arn)"
  fi

  if [[ -z "$db_user" ]]; then
    echo "Could not work out your database role from your AWS identity ($CALLER_ARN)." >&2
    echo "Set PGUSER to your database role, or pass --db-user USER." >&2
    exit 1
  fi

  if [[ "$print_user" == "true" ]]; then
    printf '%s\n' "$db_user"
    return
  fi

  aws rds generate-db-auth-token \
    --profile "$profile" \
    --region "$region" \
    --hostname "$host" \
    --port "$remote_port" \
    --username "$db_user"
}

main() {
  require_command jq
  require_command aws

  if [[ $# -lt 1 ]]; then
    usage
    exit 1
  fi

  case "$1" in
    -h|--help|help)
      usage
      ;;

    *)
      generate_token "$@"
      ;;
  esac
}

main "$@"
